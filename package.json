{
  "name": "droch-apps",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx tooling/dev.ts up",
    "dev:stop": "tsx tooling/dev.ts stop",
    "dev:logs": "tsx tooling/dev.ts logs",
    "dev:server": "tsx watch server/src/main.ts",
    "build": "tsx tooling/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --threads=1 --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "db:generate": "tsx tooling/generate-migrations.ts",
    "db:migrate": "tsx tooling/migrate.ts",
    "start": "node dist/server/main.mjs",
    "test:image": "tsx tooling/test-stack.ts build",
    "test:stack": "tsx tooling/test-stack.ts up",
    "test:stack:stop": "tsx tooling/test-stack.ts stop",
    "test:stack:logs": "tsx tooling/test-stack.ts logs",
    "test:coverage": "vitest run --coverage.enabled",
    "test:coverage:changed": "vitest run --coverage.enabled --coverage.changed --coverage.reportsDirectory=coverage/changed",
    "test:e2e:coverage": "BROWSER_COVERAGE=1 playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:coverage:gate": "sh tooling/coverage-gate.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@repo/server": "workspace:*",
    "@repo/shared": "workspace:*",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@types/better-sqlite3": "9.6.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-lib-source-maps": "4.0.4",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@11.25.0"
}
