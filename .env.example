# Production configuration. Local development generates its own settings.
APP_ORIGIN=https://apps.example.com
DATA_DIRECTORY=/data
SESSION_COOKIE_NAME=droch_session
PORT=3000

# Production accounts. Set secrets in Coolify, not this file.
AUTH_MODE=production
AUTH_SECRET=
MAILTRAP_TOKEN=
MAIL_FROM=
# Optional, only when using Mailtrap Sandbox:
MAILTRAP_SANDBOX_ID=
